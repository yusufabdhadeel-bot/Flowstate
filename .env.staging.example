NODE_ENV="production"
API_PORT=4400
POSTGRES_PORT=5433
POSTGRES_DB=flowstate_staging
POSTGRES_USER=flowstate_staging
# Generate staging-only random values; never reuse production credentials.
POSTGRES_PASSWORD="replace-with-a-unique-random-staging-database-password"
DATABASE_URL="postgresql://flowstate_staging:replace-with-a-unique-random-staging-database-password@postgres:5432/flowstate_staging?schema=public"
JWT_SECRET="REPLACE_ME"
MFA_ENCRYPTION_KEY="REPLACE_ME"
SECRET_MANAGER="env"
CORS_ALLOWED_ORIGINS="https://staging.example.com"
TRUST_PROXY_HOPS=1
ENABLE_REMINDERS="false"
ENABLE_AI_PROCESSING="false"