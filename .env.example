DATABASE_URL="postgresql://postgres:password@localhost:5432/flowstate?schema=public"
PORT=4000
NODE_ENV="development"

# Comma-separated list of browser origins allowed to call the API.
# Leave empty to allow requests without an Origin header (server-to-server).
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Number of proxy hops to trust for req.ip / rate limiting (0 = none).
TRUST_PROXY_HOPS=1

# Seed password used by `npm run prisma:seed` for the demo accounts.
SEED_PASSWORD="change-me-before-seeding"

# JWT Configuration
JWT_SECRET="your-secret-key-min-32-characters-long"
MFA_ENCRYPTION_KEY="your-mfa-encryption-key-min-32-characters-long"

# Email Configuration (Nodemailer)
# SMTP server settings
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="noreply@flowstate.com"

# Optional: For production, use environment-specific values
# Example with AWS SES:
# EMAIL_HOST="email-smtp.us-east-1.amazonaws.com"
# EMAIL_PORT="587"
# EMAIL_USER="AKIA2XXXXXXXXXXXXXX"
# EMAIL_PASS="AbCD1234567890..."

# WhatsApp Notifications (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="+1234567890"
ENABLE_WHATSAPP_NOTIFICATIONS="false"

# Reminder System Configuration
ENABLE_REMINDERS="true"
REMINDER_HOURS="24"
REMINDER_CRON_SCHEDULE="0 0 * * *"
REMINDER_BATCH_SIZE="100"
CRON_TIMEZONE="UTC"

# AI Classification & Summarization (Google Gemini)
GEMINI_API_KEY="your-google-generative-ai-api-key"
ENABLE_AI_PROCESSING="false"
# Optional: Override default model
# AI_MODEL="gemini-1.5-pro"  # Default: gemini-1.5-flash

