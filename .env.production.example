NODE_ENV="production"
API_PORT=4000
POSTGRES_PORT=5432
POSTGRES_DB=flowstate
POSTGRES_USER=flowstate
# Generate unique random values; use an alphanumeric database password so it can be embedded in DATABASE_URL without URL encoding.
POSTGRES_PASSWORD="replace-with-a-unique-random-database-password"
DATABASE_URL="postgresql://flowstate:replace-with-a-unique-random-database-password@postgres:5432/flowstate?schema=public"
JWT_SECRET="REPLACE_ME"
MFA_ENCRYPTION_KEY="REPLACE_ME"
SECRET_MANAGER="env"
CORS_ALLOWED_ORIGINS="https://app.example.com"
TRUST_PROXY_HOPS=1
ENABLE_REMINDERS="false"
ENABLE_AI_PROCESSING="false"
